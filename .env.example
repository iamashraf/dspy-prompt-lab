# Copy to .env and edit. .env is git-ignored. Never commit a real key.

# Which provider to use: ollama (local, free), openai, or anthropic.
DSPY_LAB_PROVIDER=ollama

# Optional. Leave empty to use the default for the provider:
#   ollama -> llama3.1:8b   openai -> gpt-4o-mini   anthropic -> claude-haiku-5-5
DSPY_LAB_MODEL=

# Keys are read only for the provider you picked.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama server. Change it if Ollama runs elsewhere.
OLLAMA_API_BASE=http://localhost:11434
