# Copy to .env and edit. .env is git-ignored. Never commit a real key.

# Which model to use: ollama (local, free) or anthropic.
DSPY_LAB_PROVIDER=ollama

# Optional. Leave empty to use the default for the provider:
#   ollama -> llama3.1:8b   anthropic -> claude-haiku-5-5
DSPY_LAB_MODEL=

# Anthropic needs no key if you are logged in with the Anthropic CLI (`ant auth login`).
# Otherwise set a key here. It is read only when DSPY_LAB_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Ollama server. It also serves the embeddings for example 11, whichever provider you pick.
OLLAMA_API_BASE=http://localhost:11434
